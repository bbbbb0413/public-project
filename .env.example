# docker compose 로컬 실행용 환경변수 템플릿.
# 복사해서 .env 로 저장하고 값을 채울 것: cp .env.example .env
# .env 자체는 .gitignore 에 의해 커밋되지 않는다.

# ── 공통 ──────────────────────────────────────────────────────
NODE_ENV=development
# 콤마(,)로 여러 origin 지정 가능 (gateway/identity/ai-service 모두 split(',')로 파싱)
ALLOWED_ORIGINS=http://localhost:5175,http://10.250.173.51:5175

# ── MySQL (db) ───────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
DB_USER=admin
DB_USER_PW=

# ── MongoDB (mongo) ──────────────────────────────────────────
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# ── 인증 토큰 시크릿 (예: openssl rand -hex 32 로 생성) ────────
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# ── ai-service-py (LLM / 임베딩) ─────────────────────────────
# LLM_PROVIDER: claude | openai | gemini | groq | ollama
LLM_PROVIDER=groq
# EMBEDDING_PROVIDER: ollama | gemini | openai (groq는 임베딩 미구현)
EMBEDDING_PROVIDER=ollama

# Groq (LLM_PROVIDER=groq 일 때 필수 — https://console.groq.com/keys 무료 발급)
GROQ_API_KEY=
# llama-3.3-70b-versatile는 2026-08-16 폐기됨
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (EMBEDDING_PROVIDER=ollama 일 때 — 호스트에 ollama 가 떠 있어야 함)
OLLAMA_MODEL=phi4:14b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
LLM_FALLBACK_CHAIN=phi4:14b

# 다른 LLM_PROVIDER/EMBEDDING_PROVIDER 를 쓸 경우에만 채우면 됨
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google Gemini — https://aistudio.google.com/apikey 무료 발급
GOOGLE_API_KEY=
# text-embedding-004는 폐기됨. gemini-embedding-001 사용 (GA, 무료 티어)
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# 사용 중인 임베딩 모델의 출력 차원과 반드시 일치시킬 것
# (Qdrant 컬렉션 벡터 크기와 불일치하면 에러 발생)
# ollama qwen3-embedding:4b=2560, gemini-embedding-001=768/1536/3072(권장), openai text-embedding-3-small=1536
EMBEDDING_DIMENSION=1536

# ── 프론트엔드 빌드 인자 ──────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
VITE_IDENTITY_API_BASE_URL=http://localhost:18080
