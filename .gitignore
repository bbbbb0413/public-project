# 이 저장소는 spec 문서와 파이프라인 설정을 관리한다.
# 실제 애플리케이션 코드는 각자의 저장소에 있다.

# ── 비밀값·개인 파일 ─────────────────────────────────────────
.env
.env.*
# .env.example 은 플레이스홀더만 있는 템플릿으로 확인했으므로 추적한다.
!.env.example
*.pem
*.key
*.p12
*.pdf

# ── 하위 저장소 ──────────────────────────────────────────────
# 각각 독립된 git 저장소다. 여기서 추적하면 gitlink 가 생겨
# 커밋 해시만 남고 내용은 올라가지 않는다.
public-front/
public-server/
public-python-server/
public-infra/

# ── 로컬 도구 설정 ───────────────────────────────────────────
.claude/
.vscode/
.idea/

# ── 파이프라인 실행 산출물 ───────────────────────────────────
# runs/ 는 프롬프트와 에이전트 출력이라 매일 밤 늘어난다.
# state.json 은 매 실행마다 바뀌는 기계 상태여서 추적하면
# 워킹트리가 늘 더러운 채로 남는다.
.specflow/runs/
.specflow/state.json
.specflow/run.lock
.specflow/DISABLED

# ── OS·편집기 ────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
*.swp
*~

# ── 의존성·빌드 산출물 ───────────────────────────────────────
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
